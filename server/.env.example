# ==============================================
# BAUST EVENT SYSTEM - Server Environment Variables
# ==============================================

# Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Admin Service Account Credentials
FIREBASE_PROJECT_ID=baust-event-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@baust-event-system.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Security & Tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d
QR_SIGNING_SECRET=replace_with_a_secure_random_qr_signing_secret_key

# bKash Payment Gateway (Sandbox Placeholders)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

# SMTP Email Service (Placeholders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="BAUST Event System <noreply@baust.edu.bd>"

