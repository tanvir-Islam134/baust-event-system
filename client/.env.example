# ==============================================
# BAUST EVENT SYSTEM - Client Environment Variables
# ==============================================

# API Base URL (defaults to /api/v1 via Vite proxy)
VITE_API_BASE_URL=/api/v1

# Firebase Web App Credentials (Auth Only)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=baust-event-system.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=baust-event-system
VITE_FIREBASE_STORAGE_BUCKET=baust-event-system.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

